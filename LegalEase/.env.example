# Copy this file to .env and fill in your key. NEVER commit .env.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-1.5-flash

# Set to 1 to test without an API key (returns a template document)
LEGALEASE_MOCK=0

# Frontend -> backend address
API_URL=http://localhost:8000
